{
  "name": "hylia",
  "version": "0.7.0",
  "description": "A simple Eleventy starter kit to help you have a blog of your own",
  "main": "index.js",
  "dependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-plugin-rss": "^1.0.7",
    "@11ty/eleventy-plugin-syntaxhighlight": "^2.0.3",
    "concurrently": "^9.2.1",
    "eleventy-plugin-youtube-embed": "^1.6.5",
    "html-minifier": "^4.0.0",
    "json-to-scss": "^1.3.1",
    "katex": "^0.16.45",
    "lite-youtube-embed": "0.3.3",
    "posthtml": "^0.16.7",
    "posthtml-parser": "^0.11.0",
    "sass": "^1.26.3",
    "slugify": "^1.4.0",
    "stalfos": "https://github.com/hankchizljaw/stalfos.git#c8971d22726326cfc04089b2da4d51eeb1ebb0eb",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@11ty/eleventy-img": "^6.0.4",
    "chokidar": "^3.6.0",
    "chokidar-cli": "^3.0.0",
    "make-dir-cli": "^4.0.0",
    "markdown-it": "^14.3.0",
    "metascraper": "^5.26.0",
    "metascraper-amazon": "^5.26.0",
    "metascraper-author": "^5.26.0",
    "metascraper-clearbit": "^5.26.0",
    "metascraper-date": "^5.26.0",
    "metascraper-description": "^5.26.0",
    "metascraper-image": "^5.26.0",
    "metascraper-logo": "^5.26.0",
    "metascraper-logo-favicon": "^5.26.0",
    "metascraper-publisher": "^5.26.0",
    "metascraper-soundcloud": "^5.26.0",
    "metascraper-spotify": "^5.26.0",
    "metascraper-title": "^5.26.0",
    "metascraper-url": "^5.26.0",
    "metascraper-youtube": "^5.26.0",
    "prettier": "^1.19.1",
    "sharp": "^0.33.5"
  },
  "overrides": {
    "lite-youtube-embed": "0.3.3"
  },
  "scripts": {
    "build:css": "node scripts/build-css.cjs",
    "build:css:watch": "node scripts/build-css.cjs --watch",
    "start": "npm run build:css && concurrently \"npm run build:css:watch\" \"npm run watch:deletions\" \"npm run serve\"",
    "watch:deletions": "node scripts/watch-deletions.cjs",
    "serve": "eleventy --serve",
    "production": "npm run build:css && eleventy",
    "fetch:previews": "node scripts/fetch-previews.cjs"
  },
  "repository": {
    "type": "git",
