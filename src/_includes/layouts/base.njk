<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="ie=edge">
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="{{ site.url }}/feed.xml" />
  <link rel="icon" href="{{ site.faviconPath }}.png" type="image/png" />
  <link rel="icon" href="{{ site.faviconPath }}.webp" type="image/webp" />
  <link rel="icon" href="{{ site.faviconPath }}.svg" type="image/svg" />
  {% include "partials/global/meta-info.njk" %}
  <script>
    document.documentElement.classList.remove('no-js');
    // Apply the saved theme choice (stored by the inline theme-toggle
    // script at the end of <body>) before first paint so the page
    // renders in the chosen theme with no flash.
    // With no saved choice, CSS falls back to prefers-color-scheme.
    try {
      const savedTheme = localStorage.getItem('user-color-scheme');
      if (savedTheme === 'light' || savedTheme === 'dark') {
        document.documentElement.setAttribute('data-theme', savedTheme);
      }
    } catch (e) {}
  </script>
  <style id="global-css">{{ cssBuild.content | safe }}</style>
  {#
  <!-- Global site tag (gtag.js) - Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-D4RED46RPS"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-D4RED46RPS');
  </script>
  #}
  {% block head %}
  {% endblock %}
</head>
<body>
  {% include "partials/global/site-head.njk" %}
  {% block content %}
  {% endblock content %}
  {% include "partials/global/site-foot.njk" %}
  {% block foot %}
  {% endblock %}
  <script>
    // Theme toggle. With no saved choice the effective mode follows the
    // system preference (CSS prefers-color-scheme fallback); clicking
    // records an explicit choice in localStorage that overrides it.
    (() => {
      const key = 'user-color-scheme';
      const btn = document.querySelector('.js-mode-toggle');
      if (!btn) return;
      const status = document.querySelector('.js-mode-status');
      const effective = () => {
        let saved = null;
        try { saved = localStorage.getItem(key); } catch (e) {}
        if (saved === 'light' || saved === 'dark') return saved;
        return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
      const show = mode => {
        btn.innerText = `${mode === 'dark' ? 'Light' : 'Dark'} theme`;
        if (status) status.innerText = `Color mode is now "${mode}"`;
      };
      btn.addEventListener('click', () => {
        const next = effective() === 'dark' ? 'light' : 'dark';
        try { localStorage.setItem(key, next); } catch (e) {}
        document.documentElement.setAttribute('data-theme', next);
        show(next);
      });
      show(effective());
    })();
  </script>
</body>
</html>
