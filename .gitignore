# Specifics

# Hide design tokens
src/scss/_tokens.scss

# Generated data caches live in .cache/ (gitignored above), not in
# src/_data: css-build.json (build output — regenerated by
# scripts/build-css.cjs before every build; in --serve mode the CSS
# watcher triggers page rebuilds by touching src/_data/site.json, since
# Eleventy's watcher honors this file), cv-sizes.json (auto-measured per
# production build by scripts/measure-cv-sizes.cjs) and link-previews.json
# (fetched by scripts/fetch-previews.cjs on every build). A build without
# them degrades gracefully (freshly built CSS / constant content-visibility
# estimates / plain links), so a fresh clone still builds a complete site.

src/_includes/assets/*
